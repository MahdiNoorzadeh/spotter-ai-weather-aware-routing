# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional: if set, Mapbox Directions is preferred; OSRM is the free fallback.
MAPBOX_ACCESS_TOKEN=

# Nominatim requires a descriptive User-Agent and respectful usage.
NOMINATIM_USER_AGENT=SpotterAI-Assessment/1.0 (mahdinoorzadeh1@gmail.com)

# Optional shared cache (Redis URL). Without it, local-memory cache is used.
REDIS_URL=
HTTP_TIMEOUT_SECONDS=12
WEATHER_CACHE_SECONDS=1800
ROUTE_CACHE_SECONDS=900
GEOCODE_CACHE_SECONDS=86400
